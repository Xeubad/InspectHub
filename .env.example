# 复制本文件为 .env 并修改所有取值后再 docker compose up
# cp .env.example .env

# 数据库 root 密码（必填，使用强随机字符串）
DB_PASSWORD=change_me_to_a_strong_password

# JWT 签名密钥（必填，使用强随机字符串，例如 openssl rand -base64 32 的输出）
JWT_SECRET=change_me_to_a_random_secret

# 初始管理员账号（仅在数据库没有任何管理员时创建）
ADMIN_USERNAME=admin
# 留空则首次启动时生成随机密码并打印在服务日志里（docker compose logs server）
ADMIN_PASSWORD=
